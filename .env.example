# MongoDB Atlas connection string (replace user, password and cluster)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=studiospace

# Any long random text. Used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-text

# Your frontend address (comma separated if more than one)
CLIENT_URL=http://localhost:3000

PORT=5000
